REM Keep each command visible in the local command processor for troubleshooting.
ECHO Running WIN98CTL self-test...
IF EXIST SELFTEST.TXT DEL SELFTEST.TXT
START /WAIT WIN98CTL.EXE --self-test
IF NOT EXIST SELFTEST.TXT GOTO NO_OUTPUT
IF ERRORLEVEL 1 GOTO FAILED
TYPE SELFTEST.TXT
FIND "Result: PASS" SELFTEST.TXT >NUL
IF ERRORLEVEL 1 GOTO FAILED
START /WAIT WIN98SUP.EXE --self-test
IF ERRORLEVEL 1 GOTO FAILED
ECHO.
ECHO PASS - now start WIN98SUP.EXE and run the host smoke test.
GOTO END
:NO_OUTPUT
ECHO.
ECHO FAIL - WIN98CTL.EXE did not create SELFTEST.TXT.
ECHO The program may have crashed before or during its self-test.
GOTO END
:FAILED
IF EXIST SELFTEST.TXT TYPE SELFTEST.TXT
ECHO.
ECHO FAIL - copy SELFTEST.TXT, MCPAGENT.LOG, MCPCRASH.LOG and MCPSUPERVISOR.LOG back to the host.
:END
PAUSE
