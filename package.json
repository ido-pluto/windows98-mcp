{
  "name": "windows98-mcp",
  "version": "0.0.0-development",
  "type": "module",
  "description": "Control a Windows 98 VM through MCP with screenshots, mouse, keyboard, shell, files, windows, and exclusive leases",
  "bin": {
    "windows98-mcp": "./dist/src/cli.js",
    "win98-mcp": "./dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/write-package-info.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "broker": "tsx src/cli.ts broker",
    "mcp": "tsx src/cli.ts stdio",
    "configure": "tsx src/cli.ts configure",
    "doctor": "tsx src/cli.ts doctor",
    "simulator": "tsx src/cli.ts simulator",
    "smoke-test": "tsx src/cli.ts smoke-test",
    "diagnostics": "tsx src/cli.ts diagnostics",
    "prepack": "npm run build && node scripts/verify-package.mjs",
    "release": "npx --yes semantic-release@25.0.8",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "pngjs": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pngjs": "6.0.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "windows-98",
    "windows98",
    "remote-control",
    "virtual-machine",
    "automation",
    "codex",
    "legacy-windows"
  ],
  "author": "Ido S.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ido-pluto/windows98-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ido-pluto/windows98-mcp/issues"
  },
  "homepage": "https://github.com/ido-pluto/windows98-mcp#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": false
  },
  "bundledDependencies": [
    "@modelcontextprotocol/sdk"
  ]
}
